## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
publish/

# Visual Studio cache/options directory
.vs/
.vscode/

# VS Code
*.code-workspace

# Rider
.idea/

# NuGet Packages
*.nupkg
**/packages/*

# Environment files
.env
*.env.local

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Application settings (keep examples)
appsettings.json
!appsettings.*.json